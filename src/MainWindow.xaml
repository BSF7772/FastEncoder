<Window
    x:Class="FastEncoder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FastEncoder"
    xmlns:core="using:FastEncoder.Core"
    Title="FastEncoder">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop"
          KeyDown="Root_KeyDown" IsTabStop="True" TabIndex="100"
          FocusVisualPrimaryThickness="0" FocusVisualSecondaryThickness="0">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="MinWidth" Value="36" />
            </Style>
            <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7C3AED" Offset="0" />
                <GradientStop Color="#2563EB" Offset="0.55" />
                <GradientStop Color="#06B6D4" Offset="1" />
            </LinearGradientBrush>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================================ title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/logo.png" Width="20" Height="20" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="FastEncoder" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="shrink videos, keep the quality" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel x:Name="TitleChips" Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection><EntranceThemeTransition FromHorizontalOffset="24" IsStaggeringEnabled="True" /></TransitionCollection>
                </StackPanel.ChildrenTransitions>
            </StackPanel>
            <!-- shimmering line while encoding -->
            <Rectangle x:Name="BusyLine" Grid.ColumnSpan="4" Height="2" VerticalAlignment="Bottom" Margin="-16,0,0,0"
                       Fill="{StaticResource BrandGradient}" Opacity="0">
                <Rectangle.OpacityTransition><ScalarTransition /></Rectangle.OpacityTransition>
            </Rectangle>
        </Grid>

        <!-- ================================================================ content -->
        <Grid Grid.Row="1" Padding="12,4,12,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="392" />
            </Grid.ColumnDefinitions>
            <Grid.ChildrenTransitions>
                <TransitionCollection><EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" /></TransitionCollection>
            </Grid.ChildrenTransitions>

            <!-- ============================================ queue -->
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,14,12,8" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Queue" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <InfoBadge x:Name="QueueBadge" Value="0" Style="{ThemeResource AttentionValueInfoBadgeStyle}" Visibility="Collapsed" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="AddFiles_Click" ToolTipService.ToolTip="Add videos (Ctrl+O)">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="AddFolder_Click" ToolTipService.ToolTip="Add a folder of videos">
                            <FontIcon Glyph="&#xE8F4;" FontSize="14" />
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" ToolTipService.ToolTip="Clear">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Remove finished" Click="ClearFinished_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Remove all" Click="ClearAll_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="Single" Padding="4,0,4,8"
                              SelectionChanged="QueueList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition IsStaggeringEnabled="True" />
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:JobItem">
                                <Grid Padding="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Show original in Explorer" Tag="{x:Bind}" Click="RevealSource_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Show result in Explorer" Tag="{x:Bind}" Click="RevealOutput_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Compress again" Tag="{x:Bind}" Click="RequeueJob_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Remove from queue" Tag="{x:Bind}" Click="RemoveJob_Click">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Border Width="76" Height="46" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <Grid>
                                            <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill" />
                                            <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}" Width="18" Height="18"
                                                          Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextBlockStyle}"
                                                   ToolTipService.ToolTip="{x:Bind Path}" />
                                        <TextBlock Text="{x:Bind Meta, Mode=OneWay}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind TrimBadge, Mode=OneWay}" Visibility="{x:Bind HasTrim, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="1" Margin="0,4,0,0"
                                                     Visibility="{x:Bind ShowProgress, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="11" Foreground="{x:Bind StatusBrush, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{x:Bind StatusBrush, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- empty state -->
                    <Grid x:Name="QueueEmpty" Grid.Row="1" Margin="14,4,14,14">
                        <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="4,3"
                                   Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="16">
                            <TextBlock x:Name="EmptyEmoji" Text="🎬" FontSize="44" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><CompositeTransform x:Name="EmptyEmojiT" /></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="Drop videos here" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="or folders — everything inside gets queued" HorizontalAlignment="Center" TextAlignment="Center"
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,6,0,0" Click="AddFiles_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                    <TextBlock Text="Browse videos" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================================ preview + edits -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="12">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- video surface -->
                        <Border CornerRadius="8" Background="#FF0B0B10">
                            <Grid>
                                <MediaPlayerElement x:Name="Player" Stretch="Uniform" AreTransportControlsEnabled="False"
                                                    Tapped="Player_Tapped" />
                                <!-- empty -->
                                <StackPanel x:Name="PlayerEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE714;" FontSize="48" Foreground="#55FFFFFF" />
                                    <TextBlock Text="Select a video to preview" Foreground="#99FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Space play · I / O set trim · ← → seek" Foreground="#55FFFFFF" FontSize="12" HorizontalAlignment="Center" />
                                </StackPanel>
                                <!-- loading -->
                                <StackPanel x:Name="PlayerLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
                                    <ProgressRing x:Name="PlayerLoadingRing" IsIndeterminate="True" Width="40" Height="40" Maximum="1" />
                                    <TextBlock x:Name="PlayerLoadingText" Text="Loading…" Foreground="#CCFFFFFF" HorizontalAlignment="Center" />
                                </StackPanel>
                                <!-- sample badge -->
                                <Border x:Name="SampleBadge" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Padding="10,4"
                                        CornerRadius="12" Background="{StaticResource BrandGradient}" Visibility="Collapsed">
                                    <TextBlock Text="COMPRESSED SAMPLE" Foreground="White" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" />
                                </Border>
                                <!-- big play pulse -->
                                <Border x:Name="PlayPulse" Width="72" Height="72" CornerRadius="36" Background="#88000000"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                                    <FontIcon x:Name="PlayPulseIcon" Glyph="&#xE768;" FontSize="28" Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- filmstrip + trim -->
                        <Grid Grid.Row="1" x:Name="Strip" Height="58" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                              PointerPressed="Strip_PointerPressed" PointerMoved="Strip_PointerMoved" PointerReleased="Strip_PointerReleased"
                              PointerCaptureLost="Strip_PointerCaptureLost" SizeChanged="Strip_SizeChanged">
                            <Grid x:Name="StripFrames">
                                <Grid.ChildrenTransitions>
                                    <TransitionCollection><EntranceThemeTransition FromHorizontalOffset="30" IsStaggeringEnabled="True" /></TransitionCollection>
                                </Grid.ChildrenTransitions>
                            </Grid>
                            <Canvas x:Name="StripOverlay" IsHitTestVisible="False" Visibility="Collapsed">
                                <Rectangle x:Name="DimLeft" Fill="#B0000000" Height="58" />
                                <Rectangle x:Name="DimRight" Fill="#B0000000" Height="58" />
                                <Border x:Name="TrimFrame" Height="58" BorderThickness="0,3,0,3" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" />
                                <Border x:Name="HandleL" Width="12" Height="58" CornerRadius="6,0,0,6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <Rectangle Width="2" Height="18" RadiusX="1" RadiusY="1" Fill="White" />
                                </Border>
                                <Border x:Name="HandleR" Width="12" Height="58" CornerRadius="0,6,6,0" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <Rectangle Width="2" Height="18" RadiusX="1" RadiusY="1" Fill="White" />
                                </Border>
                                <Rectangle x:Name="Playhead" Width="3" Height="66" Canvas.Top="-4" RadiusX="1.5" RadiusY="1.5" Fill="White">
                                </Rectangle>
                            </Canvas>
                        </Grid>

                        <!-- transport -->
                        <Grid Grid.Row="2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PlayButton" Style="{StaticResource AccentButtonStyle}" Width="44" Height="36" Padding="0"
                                    Click="PlayPause_Click" ToolTipService.ToolTip="Play / pause (Space)" CornerRadius="18">
                                <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="14" />
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="TimeText" Text="00:00.0 / 00:00" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
                                <TextBlock x:Name="TrimText" Text="Full length" Style="{StaticResource Caption}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                <Button Style="{StaticResource IconButton}" Click="SetIn_Click" ToolTipService.ToolTip="Start here (I)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE892;" FontSize="12" />
                                        <TextBlock Text="Start" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="SetOut_Click" ToolTipService.ToolTip="End here (O)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="End" />
                                        <FontIcon Glyph="&#xE893;" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Click="ResetTrim_Click" ToolTipService.ToolTip="Reset trim (R)">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                </Button>
                                <ToggleButton x:Name="LoopToggle" Padding="8,6" IsChecked="True" ToolTipService.ToolTip="Loop inside the trim">
                                    <FontIcon Glyph="&#xE8EE;" FontSize="13" />
                                </ToggleButton>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- edits -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
                    <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEC4A;" FontSize="14" />
                                    <TextBlock Text="Playback speed" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="SpeedText" Text="1×" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </Grid>
                            <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="4" StepFrequency="0.25" TickFrequency="0.25" TickPlacement="None"
                                    Value="1" ValueChanged="Edit_ValueChanged" IsThumbToolTipEnabled="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE767;" FontSize="14" />
                                    <TextBlock Text="Volume" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="VolumeText" Text="100 %" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </Grid>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="300" StepFrequency="5" Value="100"
                                    ValueChanged="Edit_ValueChanged" IsThumbToolTipEnabled="False" />
                        </StackPanel>
                        <ToggleButton x:Name="MuteToggle" Grid.Column="2" VerticalAlignment="Center" Padding="12,8"
                                      Click="Mute_Click" ToolTipService.ToolTip="Remove the audio track">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74F;" FontSize="14" />
                                <TextBlock Text="No audio" />
                            </StackPanel>
                        </ToggleButton>
                    </Grid>

                    <!-- audio sync (per video) -->
                    <Grid x:Name="SyncRow" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="14" />
                                    <TextBlock Text="Audio sync" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="SyncHint" Text="this video · drag while it plays to hear the change" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock x:Name="SyncText" Text="in sync" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                            </Grid>
                            <Slider x:Name="SyncSlider" Minimum="-1500" Maximum="1500" StepFrequency="5" SmallChange="5" LargeChange="50" Value="0"
                                    ValueChanged="Sync_ValueChanged" IsThumbToolTipEnabled="False"
                                    ToolTipService.ToolTip="Left = sound earlier · right = sound later" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="SyncEarlierButton" Style="{StaticResource IconButton}" Click="SyncNudge_Click" Tag="-10" ToolTipService.ToolTip="Sound 10 ms earlier">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                            <Button x:Name="SyncLaterButton" Style="{StaticResource IconButton}" Click="SyncNudge_Click" Tag="10" ToolTipService.ToolTip="Sound 10 ms later">
                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                            </Button>
                            <SplitButton x:Name="DetectButton" Click="Detect_Click" Padding="10,5"
                                         ToolTipService.ToolTip="Measure the offset by matching sounds (shots, hits) with flashes and impacts in the picture">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="13" />
                                    <TextBlock x:Name="DetectText" Text="Detect" />
                                </StackPanel>
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="TopEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Detect for every video in the queue" Click="DetectAll_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Use this offset for every video" Click="SyncApplyAll_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Reset to 0" Click="SyncReset_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <ToggleMenuFlyoutItem x:Name="FixSyncToggle" Text="Fix timing drift (all videos)" Click="FixSync_Click"
                                                              ToolTipService.ToolTip="Even frame rate + audio placed by its timestamps. Game captures (Steam, ShadowPlay, OBS) drift in editors and some players without it." />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                        </StackPanel>
                    </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================ presets / settings -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel Spacing="12">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection><RepositionThemeTransition /></TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <Border Style="{StaticResource Card}" Padding="12,14,12,8">
                        <StackPanel>
                            <Grid Margin="4,0,4,8">
                                <TextBlock Text="Preset" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Border x:Name="CustomPill" HorizontalAlignment="Right" Padding="8,2" CornerRadius="10"
                                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="Collapsed">
                                    <TextBlock Text="Customized" FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </Border>
                            </Grid>
                            <GridView x:Name="PresetGrid" SelectionMode="Single" IsItemClickEnabled="False"
                                      SelectionChanged="PresetGrid_SelectionChanged" ScrollViewer.VerticalScrollMode="Disabled">
                                <GridView.ItemContainerTransitions>
                                    <TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="28" /></TransitionCollection>
                                </GridView.ItemContainerTransitions>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="core:Preset">
                                        <Grid Width="164" Height="118" Padding="12,10" RowSpacing="2"
                                              PointerEntered="Tile_PointerEntered" PointerExited="Tile_PointerExited"
                                              Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{x:Bind Emoji}" FontSize="24" FontFamily="Segoe UI Emoji" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Padding="7,2" CornerRadius="9"
                                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                                <TextBlock Text="{x:Bind Savings}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Grid.Row="2" Text="{x:Bind Tagline}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                                       MaxLines="3" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </StackPanel>
                    </Border>

                    <!-- target size -->
                    <Border x:Name="TargetCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🎯  Target file size" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="TargetBox" Minimum="1" Maximum="100000" SmallChange="1" LargeChange="10"
                                           SpinButtonPlacementMode="Inline" ValueChanged="TargetBox_ValueChanged" />
                                <TextBlock Grid.Column="1" Text="MB" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="8 MB" Tag="8" Click="TargetQuick_Click" />
                                <Button Content="10 MB" Tag="10" Click="TargetQuick_Click" />
                                <Button Content="25 MB" Tag="25" Click="TargetQuick_Click" />
                                <Button Content="50 MB" Tag="50" Click="TargetQuick_Click" />
                                <Button Content="100 MB" Tag="100" Click="TargetQuick_Click" />
                            </StackPanel>
                            <TextBlock Text="Each file in the queue is squeezed to this size. Long videos at small sizes get blurry — trim or speed them up first."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- estimate -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="Size estimate" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="EstimateFor" HorizontalAlignment="Right" Style="{StaticResource Caption}" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="EstimateBig" Text="—" FontSize="30" FontWeight="SemiBold" />
                                    <TextBlock x:Name="EstimateSmall" Text="Encode a few seconds to see the real size" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid Grid.Column="1" Width="64" Height="64">
                                    <ProgressRing x:Name="SavingsRing" IsIndeterminate="False" Width="64" Height="64" Maximum="100" Value="0"
                                                  Background="{ThemeResource ControlFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SavingsText" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                                </Grid>
                            </Grid>
                            <ProgressBar x:Name="EstimateProgress" Maximum="1" Visibility="Collapsed" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="EstimateButton" HorizontalAlignment="Stretch" Click="Estimate_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                        <TextBlock x:Name="EstimateButtonText" Text="Estimate" />
                                    </StackPanel>
                                </Button>
                                <ToggleButton x:Name="CompareToggle" Grid.Column="1" HorizontalAlignment="Stretch" IsEnabled="False" Click="Compare_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8FF;" FontSize="14" />
                                        <TextBlock Text="View sample" />
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- fine-tune -->
                    <Expander x:Name="FineTune" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Padding="0,10">
                                <TextBlock Text="Fine-tune" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="FineTuneSummary" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="14">
                            <ComboBox x:Name="EncoderBox" Header="Encoder" HorizontalAlignment="Stretch" SelectionChanged="Fine_Changed" />
                            <StackPanel x:Name="QualityPanel">
                                <Grid>
                                    <TextBlock Text="Quality" />
                                    <TextBlock x:Name="QualityText" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                                <Slider x:Name="QualitySlider" StepFrequency="1" ValueChanged="Fine_Changed" IsThumbToolTipEnabled="False" />
                                <Grid>
                                    <TextBlock Text="◀ better picture" Style="{StaticResource Caption}" />
                                    <TextBlock Text="smaller file ▶" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                            <StackPanel x:Name="SpeedPanel">
                                <Grid>
                                    <TextBlock Text="Effort" />
                                    <TextBlock x:Name="EffortText" HorizontalAlignment="Right" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                                <Slider x:Name="EffortSlider" StepFrequency="1" Minimum="0" ValueChanged="Fine_Changed" IsThumbToolTipEnabled="False" />
                                <Grid>
                                    <TextBlock Text="◀ slower, smaller" Style="{StaticResource Caption}" />
                                    <TextBlock Text="faster ▶" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                            <Grid ColumnSpacing="8" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox x:Name="ResolutionBox" Header="Resolution" HorizontalAlignment="Stretch" SelectionChanged="Fine_Changed" />
                                <ComboBox x:Name="FpsBox" Grid.Column="1" Header="Frame rate" HorizontalAlignment="Stretch" SelectionChanged="Fine_Changed" />
                                <ComboBox x:Name="AudioBox" Grid.Row="1" Header="Audio" HorizontalAlignment="Stretch" SelectionChanged="Fine_Changed" />
                                <ComboBox x:Name="ContainerBox" Grid.Row="1" Grid.Column="1" Header="Format" HorizontalAlignment="Stretch" SelectionChanged="Fine_Changed" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- output -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Output" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ToggleSwitch x:Name="NextToSourceSwitch" OnContent="Save next to the original" OffContent="Save to a folder"
                                          Toggled="Output_Changed" />
                            <Grid x:Name="FolderRow" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FolderBox" IsReadOnly="True" TextWrapping="NoWrap" />
                                <Button Grid.Column="1" Click="BrowseFolder_Click" ToolTipService.ToolTip="Choose folder">
                                    <FontIcon Glyph="&#xE838;" FontSize="14" />
                                </Button>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SuffixBox" Header="File name ending" PlaceholderText="_small" TextChanged="Suffix_Changed" />
                                <Button Grid.Column="1" VerticalAlignment="Bottom" Click="OpenOutput_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                        <TextBlock Text="Open folder" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <CheckBox x:Name="DeleteBiggerCheck" Content="Discard results that end up bigger than the original" Click="Output_Changed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================================================================ action bar -->
        <Border Grid.Row="2" Padding="20,12" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" MinWidth="220">
                    <TextBlock x:Name="StatusMain" Text="Ready" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="StatusSub" Text="Add some videos to begin" Style="{StaticResource Caption}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <ProgressBar x:Name="OverallProgress" Maximum="1" Value="0" Height="6" CornerRadius="3" />
                    <Grid>
                        <TextBlock x:Name="StatusLeft" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="StatusRight" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="2" Click="Cancel_Click" Visibility="Collapsed" Padding="16,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="14" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
                <Button x:Name="EncodeButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Padding="22,10"
                        Click="Encode_Click" IsEnabled="False" CornerRadius="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE945;" FontSize="16" />
                        <TextBlock x:Name="EncodeButtonText" Text="Compress" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ================================================================ drop overlay -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="3" Opacity="0" IsHitTestVisible="False"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
            <Grid.OpacityTransition><ScalarTransition Duration="0:0:0.18" /></Grid.OpacityTransition>
            <Rectangle Margin="28" RadiusX="18" RadiusY="18" StrokeThickness="3" StrokeDashArray="6,4"
                       Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <TextBlock Text="📥" FontSize="64" HorizontalAlignment="Center" />
                <TextBlock Text="Drop to add to the queue" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Videos and folders both work" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- ================================================================ toasts -->
        <StackPanel x:Name="ToastHost" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,88" Spacing="8" Width="460">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="40" />
                    <AddDeleteThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>
    </Grid>
</Window>
